{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server = .; Database = Booking_SaaS; Integrated Security=SSPI; Encrypt = False"
  },
  "JwtOptions": {
    "SecretKey": "YOUR_KEY",
    "Issuer": "YOUR_ISSUER",
    "Audience": "YOUR_AUDIENCE",
    "AccessTokenDurationInMinutes": 10,
    "RefreshTokenDurationInDays": 1
  },
  "EmailOptions": {
    "EmailAddress": "YOUR_EMAIL",
    "Password": "YOUR_PASSWORD",
    "LogoUrl": "https://static.vecteezy.com/system/resources/previews/024/150/216/non_2x/calendar-icon-vector.jpg"
  },
  "CachingOptions": {
    "Host": "YOUR_REDIS_HOST",
    "Port": "13209",
    "User": "YOUR_USERNAME",
    "Password": "YOUR_PASSWORD",
    "DurationInMinutes": 20
  },
  "DomainOptions": {
    "Url": "YOUR_DOMAIN"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "%BASEDIR%/logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}    Source: {SourceContext} | RequestId: {RequestId} | Thread: {ThreadId}{NewLine}{Exception}{NewLine}---{NewLine}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}
